      "boundElements": null,
      "updated": 1784685132412,
      "link": null,
      "locked": false,
      "text": "8.3.2 Understanding the work distribution strategy\nFlash Attention uses a different parallelization strategy. Each thread block is assigned a small \"brick\" of complete output rows. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8.3.2 Understanding the work distribution strategy\nFlash Attention uses a different parallelization strategy. Each thread block is assigned a small \"brick\" of complete output rows. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
