    {
      "id": "tctFEQDVN5fkDYnroAmsi",
      "type": "text",
      "x": -2218.560637246148,
      "y": -917.9553784713705,
      "width": 649.319580078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
