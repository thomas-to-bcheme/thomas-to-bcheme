    {
      "id": "tctFEQDVN5fkDYnroAmsi",
      "type": "text",
      "x": -617.584074746148,
      "y": -898.8538159713705,
      "width": 649.319580078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
