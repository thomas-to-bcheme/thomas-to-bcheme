    {
      "id": "DwhirCGdI7uMsx0sEcjxx",
      "type": "text",
      "x": 1084.0908604904926,
      "y": -3053.351376581136,
      "width": 1280.859130859375,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
