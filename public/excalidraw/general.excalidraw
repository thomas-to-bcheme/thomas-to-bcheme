      "type": "text",
      "x": 392.61236715599557,
      "y": -4372.621431559632,
      "width": 1019.3193359375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
