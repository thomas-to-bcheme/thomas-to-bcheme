    {
      "id": "w2p0C7PxHocij1rwyX1el",
      "type": "frame",
      "x": -2938.1690642427775,
      "y": -3952.3314993507734,
      "width": 3203.351710610015,
      "height": 1502.1415944701455,
      "name": "Communication Frameworks, Methods, and Techniques",
      "angle": 0,
      "strokeColor": "#868e96",
