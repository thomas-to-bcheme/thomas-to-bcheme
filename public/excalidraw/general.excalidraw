      "seed": 1047536926,
      "version": 305,
      "versionNonce": 844198174,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786064765173,
      "link": null,
      "locked": false,
      "text": "LLM workflow (I define) vs. Agentic (autonomous)\nAI growth and adoption: addressing user fear (of AI and SWE automation) despite 100k and 1M system\nLinkedin Agent (offline) vs. Resume Agent (online)\n    -> RAG vs CAG: retrieval augmented generation vs. cache augmented generation\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM workflow (I define) vs. Agentic (autonomous)\nAI growth and adoption: addressing user fear (of AI and SWE automation) despite 100k and 1M system\nLinkedin Agent (offline) vs. Resume Agent (online)\n    -> RAG vs CAG: retrieval augmented generation vs. cache augmented generation\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
