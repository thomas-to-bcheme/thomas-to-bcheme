    {
      "id": "vl42Juvp7UQpvNAgmTFG6",
      "type": "text",
      "x": -4233.428453729059,
      "y": -1067.5879225230553,
      "width": 745.95947265625,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "qXKs2yDD1YNlc1XTBri7N",
