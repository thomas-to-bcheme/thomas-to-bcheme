        "9yEdspgF6X0dJ8A7irOZS"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zu",
      "roundness": null,
      "seed": 883513451,
      "version": 129,
      "versionNonce": 1169406885,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686000034,
      "link": null,
      "locked": false,
      "status": "pending",
      "fileId": "a82e669e2f7a93d02e93211e8a9d58c9673ee5de",
      "scale": [
        1,
