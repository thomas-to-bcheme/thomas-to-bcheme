      ],
      "crop": null
    },
    {
      "id": "WkauayZOFYJwEDyiLj_Qm",
      "type": "text",
      "x": -702.2721644983292,
      "y": -1572.9599768885412,
      "width": 327.1397705078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ACzwMADU6i-pQDqoTXqcu",
        "oKDzmHVKqPSi7MT-er-UB",
        "uarwT_BgYpEGC6YGf2dsF"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzuV",
      "roundness": null,
      "seed": 434767499,
      "version": 457,
      "versionNonce": 155601067,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686005292,
      "link": null,
      "locked": false,
      "text": "10.1.4 Ring versus tree algorithms",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "10.1.4 Ring versus tree algorithms",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oxnmZg5-_3e9_-FMKZdTk",
      "type": "text",
      "x": -1005.9185092213368,
      "y": -1520.9129632172599,
      "width": 1018.6025004039404,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ACzwMADU6i-pQDqoTXqcu",
        "oKDzmHVKqPSi7MT-er-UB",
        "uarwT_BgYpEGC6YGf2dsF"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzv",
      "roundness": null,
      "seed": 1451735973,
      "version": 514,
      "versionNonce": 1584266059,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686005292,
      "link": null,
      "locked": false,
      "text": "NCCL implements collective operations using two main algorithmic patterns: ring and tree",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NCCL implements collective operations using two main algorithmic patterns: ring and tree",
      "autoResize": false,
      "lineHeight": 1.25
    },
