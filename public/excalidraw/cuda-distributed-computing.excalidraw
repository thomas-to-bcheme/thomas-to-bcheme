      "link": null,
      "locked": false,
      "text": "Reduce",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reduce",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hlHMBhNR0drFyQDGi2I7U",
      "type": "text",
      "x": 524.3448744920374,
      "y": -2664.148322598933,
      "width": 781.7794799804688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aH",
      "roundness": null,
      "seed": 501732197,
      "version": 156,
      "versionNonce": 42477515,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Reduce is like Gather, but instead of just concatenating the pieces, it combines\nthem with an operation. Think of it as Gather with math applied.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reduce is like Gather, but instead of just concatenating the pieces, it combines them with an operation. Think of it as Gather with math applied.",
      "autoResize": false,
      "lineHeight": 1.25
    },
