        1,
        1
      ],
      "crop": null
    },
    {
      "id": "W6KciUnsqI4jkE26c5lap",
      "type": "text",
      "x": 1755.360604052859,
      "y": -2396.740689938589,
      "width": 144.47987365722656,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzy",
