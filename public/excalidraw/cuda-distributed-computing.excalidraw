    {
      "id": "0eGFwUSGReQDKny0hYyLS",
      "type": "image",
      "x": -1234.6442671637537,
      "y": -3460.113575391014,
      "width": 624.0867579908676,
      "height": 497,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
