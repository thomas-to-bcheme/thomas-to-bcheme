    {
      "id": "Au1dHGSLvYRtY9oU4q2m2",
      "type": "text",
      "x": 17.655798054483967,
      "y": -1413.686158828517,
      "width": 792.2994995117188,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ACzwMADU6i-pQDqoTXqcu",
        "oKDzmHVKqPSi7MT-er-UB",
        "uarwT_BgYpEGC6YGf2dsF"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzx",
      "roundness": null,
      "seed": 2010676555,
      "version": 404,
      "versionNonce": 446021707,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686005292,
      "link": null,
      "locked": false,
      "text": "The tree algorithm arranges GPUs in a logical binary tree. During reduction, data\nflows up from leaves to root: each leaf sends its value to a parent node, which\nsums the inputs and passes the result one level higher. Figure 10.9 shows this\nprocess with four GPUs. Values [1], [2], [3], [4] combine into partial sums at\nthe intermediate nodes, and the root ends up with the total.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The tree algorithm arranges GPUs in a logical binary tree. During reduction, data flows up from leaves to root: each leaf sends its value to a parent node, which sums the inputs and passes the result one level higher. Figure 10.9 shows this process with four GPUs. Values [1], [2], [3], [4] combine into partial sums at the intermediate nodes, and the root ends up with the total.",
      "autoResize": false,
      "lineHeight": 1.25
    },
