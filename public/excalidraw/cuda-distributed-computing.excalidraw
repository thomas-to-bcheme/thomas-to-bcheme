    },
    {
      "id": "0eGFwUSGReQDKny0hYyLS",
      "type": "image",
      "x": -2094.5075484137537,
      "y": -2935.7882984426988,
      "width": 624.0867579908676,
      "height": 497,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
