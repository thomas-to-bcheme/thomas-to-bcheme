    {
      "id": "Hna6IwBnjIJ6pXjIhJFMw",
      "type": "text",
      "x": -1885.2315724762916,
      "y": -69.87690039486506,
      "width": 759.9994506835938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6SBrtJeY207LyMls--KTs"
      ],
