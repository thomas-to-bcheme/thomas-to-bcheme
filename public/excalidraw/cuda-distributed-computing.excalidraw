      "index": "a0zl",
      "roundness": null,
      "seed": 883513451,
      "version": 66,
      "versionNonce": 372062987,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784685574773,
      "link": null,
      "locked": false,
      "status": "pending",
      "fileId": "a82e669e2f7a93d02e93211e8a9d58c9673ee5de",
