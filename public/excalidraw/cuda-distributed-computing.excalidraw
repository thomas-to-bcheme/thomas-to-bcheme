  "elements": [
    {
      "id": "6FkpARiBHbgqycidrXD3M",
      "type": "text",
      "x": -2001.7331915091986,
      "y": -3942.6851900733423,
      "width": 668.6194458007812,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0",
      "roundness": null,
      "seed": 1278593163,
      "version": 525,
      "versionNonce": 472950091,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784685470323,
      "link": null,
      "locked": false,
      "text": "Distributed computing\nThis chapter covers\nMapping multi-GPU interconnects and understanding NCCL collectives\nImplementing tensor parallelism across 8–16 GPUs\nBuilding pipeline parallel schedules that keep every stage busy\nCoordinating tensor and pipeline parallelism across nodes\nEvaluating scaling behavior and communication trade-offs",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Distributed computing\nThis chapter covers\nMapping multi-GPU interconnects and understanding NCCL collectives\nImplementing tensor parallelism across 8–16 GPUs\nBuilding pipeline parallel schedules that keep every stage busy\nCoordinating tensor and pipeline parallelism across nodes\nEvaluating scaling behavior and communication trade-offs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "geLvLJfqT0AN6TfT9z70j",
      "type": "text",
      "x": -1692.8277945466407,
      "y": -3716.402646924718,
      "width": 792.719482421875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0d",
      "roundness": null,
      "seed": 1251767269,
      "version": 97,
      "versionNonce": 1182777413,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "LansdOyJWeKSGZUNuAdRx",
          "type": "arrow"
        },
        {
          "id": "RDdzFmNf1ruAPn6QPNHQ3",
          "type": "arrow"
        }
      ],
      "updated": 1784685513743,
      "link": null,
      "locked": false,
      "text": "The two main ways GPUs communicate inside a server are over the PCIe bus and\nNVLink.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The two main ways GPUs communicate inside a server are over the PCIe bus and NVLink.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "DE9KoyKv3wCjoIssfeVJz",
      "type": "text",
      "x": -2080.9746972650637,
      "y": -3623.467356877301,
      "width": 796.5594482421875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0l",
      "roundness": null,
      "seed": 310438123,
      "version": 95,
      "versionNonce": 1452730725,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "LansdOyJWeKSGZUNuAdRx",
          "type": "arrow"
        }
      ],
      "updated": 1784685509999,
      "link": null,
      "locked": false,
      "text": "PCIe (Peripheral Component Interconnect Express): This is the standard bus\nthat connects everything on a motherboard—your GPU, network cards, storage\ndrives—to the CPU. It’s a general-purpose interconnect. Think of it like the main\ncity roads; they get you anywhere, but they’re shared and can have traffic jams.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PCIe (Peripheral Component Interconnect Express): This is the standard bus that connects everything on a motherboard—your GPU, network cards, storage drives—to the CPU. It’s a general-purpose interconnect. Think of it like the main city roads; they get you anywhere, but they’re shared and can have traffic jams.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "p3V3Y6ep5-gs7ClzBa1GF",
      "type": "text",
      "x": -1243.0517353178723,
      "y": -3623.4673568139956,
      "width": 793.4195556640625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0t",
      "roundness": null,
      "seed": 17739589,
      "version": 167,
      "versionNonce": 510014213,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "RDdzFmNf1ruAPn6QPNHQ3",
          "type": "arrow"
        }
      ],
      "updated": 1784685513743,
      "link": null,
      "locked": false,
      "text": "NVLink: This is a proprietary, point-to-point interconnect developed by NVIDIA\nspecifically for connecting GPUs to each other and to the CPU. Think of it as a\nprivate, multi-lane superhighway built exclusively for GPU traffic. It offers\nsignificantly higher bandwidth and lower latency than PCIe.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NVLink: This is a proprietary, point-to-point interconnect developed by NVIDIA specifically for connecting GPUs to each other and to the CPU. Think of it as a private, multi-lane superhighway built exclusively for GPU traffic. It offers significantly higher bandwidth and lower latency than PCIe.",
      "autoResize": false,
      "lineHeight": 1.25
    },
