      "index": "a0zzzzzzw",
      "roundness": null,
      "seed": 691799909,
      "version": 57,
      "versionNonce": 1064067403,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686006517,
      "link": null,
      "locked": false,
      "text": "NCCL automatically chooses between ring and tree based on message size and\ntopology. For AllReduce:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NCCL automatically chooses between ring and tree based on message size and topology. For AllReduce:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "wGjZ1Y9WBk0t1aNAvTsqW",
      "type": "text",
      "x": -1764.3016713532447,
      "y": 37.62309960513494,
      "width": 518.1396484375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6SBrtJeY207LyMls--KTs"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzzzx",
      "roundness": null,
      "seed": 502680939,
      "version": 57,
      "versionNonce": 1703411691,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686006517,
      "link": null,
      "locked": false,
      "text": "Messages < 256 KB: Tree algorithm (latency-optimal)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Messages < 256 KB: Tree algorithm (latency-optimal)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WF-8s5Kl8m4OH9tyzIcyW",
      "type": "text",
      "x": -1763.431645718479,
      "y": 72.62309960513494,
      "width": 516.3995971679688,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6SBrtJeY207LyMls--KTs"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzzzy",
      "roundness": null,
      "seed": 493867717,
      "version": 57,
      "versionNonce": 267831947,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686006517,
      "link": null,
      "locked": false,
      "text": "Messages > 1 MB: Ring algorithm (bandwidth-optimal)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Messages > 1 MB: Ring algorithm (bandwidth-optimal)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "E0ZU0lEynCcBR3Wk-G6LP",
      "type": "text",
      "x": -1711.3216908844947,
      "y": 107.62309960513494,
      "width": 412.1796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6SBrtJeY207LyMls--KTs"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzzzz",
      "roundness": null,
      "seed": 272590859,
      "version": 57,
      "versionNonce": 594755883,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686006517,
      "link": null,
      "locked": false,
      "text": "Messages 256 KB - 1 MB: Hybrid approach",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Messages 256 KB - 1 MB: Hybrid approach",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HwgaVGqSKPFStcKIZ30Qf",
      "type": "text",
      "x": -1904.2437759048732,
      "y": 165.30190002395602,
      "width": 780.3194580078125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "6SBrtJeY207LyMls--KTs"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzzzzV",
      "roundness": null,
      "seed": 601043493,
      "version": 93,
      "versionNonce": 157803467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686006517,
      "link": null,
      "locked": false,
      "text": "This is why you should always use NCCL instead of implementing your own\ncollectives. NCCL’s decision logic accounts for dozens of factors: NVLink\ntopology, PCIe switches, message size, data type, and even GPU architecture.\nThe library has been tuned by NVIDIA engineers over years to extract maximum\nperformance from every hardware configuration.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is why you should always use NCCL instead of implementing your own collectives. NCCL’s decision logic accounts for dozens of factors: NVLink topology, PCIe switches, message size, data type, and even GPU architecture. The library has been tuned by NVIDIA engineers over years to extract maximum performance from every hardware configuration.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "F6YdtZKFY5KSyW9VLf-hw",
      "type": "frame",
      "x": -2176.9765625000014,
      "y": -4001.8515625,
      "width": 5779.414062500002,
      "height": 8642.03125,
      "angle": 0,
      "strokeColor": "#bbb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 992116523,
      "version": 573,
      "versionNonce": 109820619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784685453031,
      "link": null,
      "locked": false,
      "name": "cuda for deep learning - chp 10 - distributed computing"
    },
    {
      "id": "XfGN1olHmy_tTZTVBTgaL",
      "type": "text",
      "x": -2056.1661940964523,
      "y": -1877.1907821196999,
      "width": 781.4195556640625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a3",
      "roundness": null,
      "seed": 298567461,
      "version": 209,
      "versionNonce": 1969743627,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "The communication cost is O(N) per GPU, where N is the size of the data being\nreduced. For a model with 1 billion parameters, that’s 4 GB of data at FP32\nprecision. With NCCL’s ring algorithm, this completes in 2(P-1) communication\nsteps for P GPUs, which on an 8-GPU system with NVLink takes about 7-10\nmilliseconds.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The communication cost is O(N) per GPU, where N is the size of the data being reduced. For a model with 1 billion parameters, that’s 4 GB of data at FP32 precision. With NCCL’s ring algorithm, this completes in 2(P-1) communication steps for P GPUs, which on an 8-GPU system with NVLink takes about 7-10 milliseconds.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "a3BHdp5YLDb0_GAjg_wez",
      "type": "text",
      "x": 2372.8112165928774,
      "y": -2693.7052455257062,
      "width": 767.4994506835938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a4",
      "roundness": null,
      "seed": 738300971,
      "version": 265,
      "versionNonce": 1703726507,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "AllGather is the opposite of ReduceScatter and the second half of AllReduce.\nEach GPU starts with a unique piece of data, and AllGather collects all the\npieces and gives the complete set to every GPU. No reduction, no math, just\ncollecting and distributing.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AllGather is the opposite of ReduceScatter and the second half of AllReduce. Each GPU starts with a unique piece of data, and AllGather collects all the pieces and gives the complete set to every GPU. No reduction, no math, just collecting and distributing.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "U3Gf8pUfoH0l9vmPqeEFM",
      "type": "text",
      "x": -1945.4091044196493,
      "y": -2731.32452576294,
      "width": 733.8394775390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a5",
      "roundness": null,
      "seed": 1486656555,
      "version": 145,
      "versionNonce": 1503387723,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "NCCL provides six core collective operations: AllReduce, Broadcast, Gather,\nReduce, ReduceScatter, and AllGather.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NCCL provides six core collective operations: AllReduce, Broadcast, Gather, Reduce, ReduceScatter, and AllGather.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "hJWy7h0qSVAxobmTvlWAu",
      "type": "text",
      "x": -2075.8087441993966,
      "y": -2627.654122558293,
      "width": 798.0593872070312,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a6",
      "roundness": null,
      "seed": 648264139,
      "version": 280,
      "versionNonce": 728735467,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "AllReduce is the workhorse of distributed training, and understanding it is key to\nunderstanding all distributed deep learning. The name tells you exactly what it\ndoes: it reduces (combines) data from all GPUs and then gives the result to all\nGPUs.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AllReduce is the workhorse of distributed training, and understanding it is key to understanding all distributed deep learning. The name tells you exactly what it does: it reduces (combines) data from all GPUs and then gives the result to all GPUs.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "NoZqmxAr3BsJWFu383dqa",
      "type": "text",
      "x": -2074.6748551030278,
      "y": -2500.7737583070375,
      "width": 787.2395629882812,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a7",
      "roundness": null,
      "seed": 1374018661,
      "version": 153,
      "versionNonce": 361925003,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Here’s the concrete scenario: You have 4 GPUs, and each GPU has computed a\npartial result. Maybe GPU 0 computed gradients from its batch of training data\nand got the value 1. GPU 1 got 2, GPU 2 got 3, and GPU 3 got 4. You want to\ncombine these partial results by summing them (1 + 2 + 3 + 4 = 10) and then give\nthat final result (10) to every GPU. That’s exactly what AllReduce does.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here’s the concrete scenario: You have 4 GPUs, and each GPU has computed a partial result. Maybe GPU 0 computed gradients from its batch of training data and got the value 1. GPU 1 got 2, GPU 2 got 3, and GPU 3 got 4. You want to combine these partial results by summing them (1 + 2 + 3 + 4 = 10) and then give that final result (10) to every GPU. That’s exactly what AllReduce does.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3pcKgmMJwDeEv28RUGrU1",
      "type": "text",
      "x": -2076.7799594476464,
      "y": -2356.184232978545,
      "width": 785.8595581054688,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a8",
      "roundness": null,
      "seed": 222316651,
      "version": 186,
      "versionNonce": 490676267,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "The \"reduce\" part means we’re applying an operation to combine the values. The\nmost common operation is sum, but you can also use max, min, or product. The\n\"all\" part means every GPU gets the final result. This is different from a regular\nreduce operation where only one GPU would get the answer.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The \"reduce\" part means we’re applying an operation to combine the values. The most common operation is sum, but you can also use max, min, or product. The \"all\" part means every GPU gets the final result. This is different from a regular reduce operation where only one GPU would get the answer.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "FEErlw8zAUT7x1BeBSKZT",
      "type": "text",
      "x": -2073.285012523218,
      "y": -2220.3261583406806,
      "width": 798.7394409179688,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a9",
      "roundness": null,
      "seed": 471271365,
      "version": 176,
      "versionNonce": 1012916939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Why is this so important? In data parallel training, each GPU processes a\ndifferent batch of data and computes gradients. But you want all GPUs to\nupdate their weights using the average gradient across all batches. AllReduce\nwith sum gives you the total gradient, which you then divide by the number of\nGPUs to get the average. Every GPU performs this AllReduce after its backward\npass, and then every GPU has the same averaged gradients to update its local\ncopy of the model.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why is this so important? In data parallel training, each GPU processes a different batch of data and computes gradients. But you want all GPUs to update their weights using the average gradient across all batches. AllReduce with sum gives you the total gradient, which you then divide by the number of GPUs to get the average. Every GPU performs this AllReduce after its backward pass, and then every GPU has the same averaged gradients to update its local copy of the model.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "yFp7m0_5oX0fafHFqe5hU",
      "type": "text",
      "x": -2058.921375904276,
      "y": -2009.2837753420856,
      "width": 796.1194458007812,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aA",
      "roundness": null,
      "seed": 445776651,
      "version": 199,
      "versionNonce": 1267683691,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "In tensor parallelism, we saw this in action: each GPU computed a partial matrix\nmultiplication result, and AllReduce summed them to give every GPU the complete\noutput matrix. In distributed batch normalization, you’d use AllReduce to\ncompute the mean and variance across all GPUs' data, not just one GPU’s batch.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In tensor parallelism, we saw this in action: each GPU computed a partial matrix multiplication result, and AllReduce summed them to give every GPU the complete output matrix. In distributed batch normalization, you’d use AllReduce to compute the mean and variance across all GPUs' data, not just one GPU’s batch.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "AtjN0HXSSYGkZbTDLbFwn",
      "type": "text",
      "x": -886.6463315857525,
      "y": -2686.615587961889,
      "width": 102.59991455078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aB",
      "roundness": null,
      "seed": 967369899,
      "version": 260,
      "versionNonce": 739765259,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Broadcast",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Broadcast",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mmSYkx34byl_6iWT0vXkZ",
      "type": "text",
      "x": -1218.6985800075338,
      "y": -2626.5701639460262,
      "width": 777.1394653320312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aC",
      "roundness": null,
      "seed": 1027952517,
      "version": 325,
      "versionNonce": 838087339,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Broadcast is simpler than AllReduce. One GPU has some data, and you want to\ncopy that exact data to every other GPU. No combining, no reduction, just\ncopying.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Broadcast is simpler than AllReduce. One GPU has some data, and you want to copy that exact data to every other GPU. No combining, no reduction, just copying.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "EVX9uwmU9RlSpI4XKFZC-",
      "type": "text",
      "x": -23.381907266281814,
      "y": -2704.230759923034,
      "width": 68.49995422363281,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aD",
      "roundness": null,
      "seed": 177525349,
      "version": 214,
      "versionNonce": 1305388363,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Gather",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gather",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tHKrIOsMTgUPnQmDTYgp7",
      "type": "text",
      "x": -349.4860922979283,
      "y": -2656.5241434581535,
      "width": 739.3395385742188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aE",
      "roundness": null,
      "seed": 866366059,
      "version": 166,
      "versionNonce": 1996604395,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "Gather is the opposite of broadcast. Instead of one GPU sending data to\neveryone, every GPU sends data to one destination GPU. The destination\ncollects all the pieces and concatenates them together.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gather is the opposite of broadcast. Instead of one GPU sending data to everyone, every GPU sends data to one destination GPU. The destination collects all the pieces and concatenates them together.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cX_d5h2vveDCn0-JX8Gua",
      "type": "image",
      "x": -278.9463863907433,
      "y": -2551.368939076448,
      "width": 699.9297994269341,
      "height": 497,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
