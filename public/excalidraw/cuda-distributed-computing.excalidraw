      "seed": 990870629,
      "version": 66,
      "versionNonce": 1275907141,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784685751991,
      "link": null,
      "locked": false,
      "text": "ReduceScatter",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReduceScatter",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BARbYDKauNrDpX5VuPGiA",
      "type": "text",
      "x": 1433.9062286721137,
      "y": -2320.805265213247,
      "width": 796.4794921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzz",
      "roundness": null,
      "seed": 1560324203,
      "version": 43,
      "versionNonce": 707334117,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784685751216,
      "link": null,
      "locked": false,
      "text": "ReduceScatter is more complex, but it’s crucial for understanding modern memory-\nefficient training like Fully Sharded Data Parallel (FSDP). The name describes\nexactly what happens: reduce the data, then scatter the result.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReduceScatter is more complex, but it’s crucial for understanding modern memory-efficient training like Fully Sharded Data Parallel (FSDP). The name describes exactly what happens: reduce the data, then scatter the result.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9uxNf62w98ueSIeZ1sXe2",
      "type": "image",
      "x": 1278.4466354538654,
      "y": -2217.161968137324,
      "width": 960.8084358523726,
      "height": 497,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzV",
      "roundness": null,
      "seed": 2068504523,
      "version": 84,
      "versionNonce": 545903691,
