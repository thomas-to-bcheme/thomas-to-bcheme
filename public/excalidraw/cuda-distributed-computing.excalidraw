      "isDeleted": false,
      "boundElements": null,
      "updated": 1784685770695,
      "link": null,
      "locked": false,
      "text": "AllGather",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AllGather",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a3BHdp5YLDb0_GAjg_wez",
      "type": "text",
      "x": 2345.8175963724893,
      "y": -2338.090399712635,
      "width": 767.4994506835938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzl",
      "roundness": null,
      "seed": 738300971,
      "version": 186,
      "versionNonce": 1680987275,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784685772362,
      "link": null,
      "locked": false,
      "text": "AllGather is the opposite of ReduceScatter and the second half of AllReduce.\nEach GPU starts with a unique piece of data, and AllGather collects all the\npieces and gives the complete set to every GPU. No reduction, no math, just\ncollecting and distributing.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AllGather is the opposite of ReduceScatter and the second half of AllReduce. Each GPU starts with a unique piece of data, and AllGather collects all the pieces and gives the complete set to every GPU. No reduction, no math, just collecting and distributing.",
      "autoResize": false,
      "lineHeight": 1.25
    },
