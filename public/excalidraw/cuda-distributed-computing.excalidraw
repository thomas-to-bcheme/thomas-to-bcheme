      "text": "ReduceScatter",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReduceScatter",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BARbYDKauNrDpX5VuPGiA",
      "type": "text",
      "x": 1460.8998488925017,
      "y": -2676.420111026318,
      "width": 796.4794921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3Lx-w4t5nJ75rAzRvgyis",
        "yPOUtbWD9f4tkwnNHwITl"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "aK",
      "roundness": null,
      "seed": 1560324203,
      "version": 133,
      "versionNonce": 1155962795,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686002509,
      "link": null,
      "locked": false,
      "text": "ReduceScatter is more complex, but it’s crucial for understanding modern memory-\nefficient training like Fully Sharded Data Parallel (FSDP). The name describes\nexactly what happens: reduce the data, then scatter the result.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ReduceScatter is more complex, but it’s crucial for understanding modern memory-efficient training like Fully Sharded Data Parallel (FSDP). The name describes exactly what happens: reduce the data, then scatter the result.",
      "autoResize": false,
      "lineHeight": 1.25
    },
