      "link": null,
      "locked": false,
      "text": "Ring algorithm",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ring algorithm",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nT0Rx6nkQerOPf31e944J",
      "type": "text",
      "x": -2035.6381169166607,
      "y": -1315.164600652307,
      "width": 792.9193725585938,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ACzwMADU6i-pQDqoTXqcu",
        "oKDzmHVKqPSi7MT-er-UB",
        "uarwT_BgYpEGC6YGf2dsF"
      ],
      "frameId": "F6YdtZKFY5KSyW9VLf-hw",
      "index": "a0zzzzvG",
      "roundness": null,
      "seed": 1845397643,
      "version": 435,
      "versionNonce": 987358347,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784686005292,
      "link": null,
      "locked": false,
      "text": "The ring algorithm arranges GPUs in a logical ring. Data flows in one direction\naround the ring, with each GPU receiving from its predecessor and sending to its\nsuccessor. This pattern achieves optimal bandwidth utilization because all links\nare active simultaneously.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ring algorithm arranges GPUs in a logical ring. Data flows in one direction around the ring, with each GPU receiving from its predecessor and sending to its successor. This pattern achieves optimal bandwidth utilization because all links are active simultaneously.",
      "autoResize": false,
      "lineHeight": 1.25
    },
