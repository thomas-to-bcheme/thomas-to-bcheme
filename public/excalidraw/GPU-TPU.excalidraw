      "frameId": "7LOYqQ3GlYuGjbJKAB7bC",
      "index": "a6",
      "roundness": null,
      "seed": 464526509,
      "version": 215,
      "versionNonce": 466707501,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784652148644,
      "link": null,
      "locked": false,
      "text": "OpenXLA, vllm-tpu-inference, JAX:\nfrom https://github.com/pytorch/xla/issues/9684#issuecomment-4201670803\nto https://developers.googleblog.com/torchtpu-running-pytorch-natively-on-tpus-at-google-scale/\nfor next steps:\n    - Integration with PyTorch’s Helion DSL\n    - Deep integrations with ecosystem pillars like vLLM and TorchTitan, alongside validated linear scaling up to full Pod-size infrastructure.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OpenXLA, vllm-tpu-inference, JAX:\nfrom https://github.com/pytorch/xla/issues/9684#issuecomment-4201670803\nto https://developers.googleblog.com/torchtpu-running-pytorch-natively-on-tpus-at-google-scale/\nfor next steps:\n    - Integration with PyTorch’s Helion DSL\n    - Deep integrations with ecosystem pillars like vLLM and TorchTitan, alongside validated linear scaling up to full Pod-size infrastructure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
