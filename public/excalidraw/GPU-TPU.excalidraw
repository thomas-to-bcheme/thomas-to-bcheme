    {
      "id": "wSWRr3zzMxYIaDT91UIFA",
      "type": "text",
      "x": -14229.03344681689,
      "y": 996.5519201796251,
      "width": 950.079345703125,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
