    {
      "id": "LG3Jvh67HTHZoiD1bGSf4",
      "type": "text",
      "x": -10617.343583149077,
      "y": 1025.4011900502405,
      "width": 957.8887223238947,
      "height": 2200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ah-LUpVdb3hy3whpdapTQ"
