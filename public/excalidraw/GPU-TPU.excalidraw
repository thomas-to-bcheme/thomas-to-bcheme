    {
      "id": "KPDzpy0x--asSDuWZIsPY",
      "type": "text",
      "x": -13883.505745934555,
      "y": -1953.6570066318423,
      "width": 537.7996215820312,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
