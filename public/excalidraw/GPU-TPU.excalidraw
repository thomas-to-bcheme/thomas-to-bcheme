      "versionNonce": 87474060,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784678458619,
      "link": null,
      "locked": false,
      "text": "Cuda refers to the entire ecosystem\nCUDA C++\ncuBLAS : optimized linear algebra (pyTorch built ontop)\ncuDNN : deep learning primitives (pyTorch built ontop)1\nCUTLASS : template library\nThreads : parallel algorthims",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cuda refers to the entire ecosystem\nCUDA C++\ncuBLAS : optimized linear algebra (pyTorch built ontop)\ncuDNN : deep learning primitives (pyTorch built ontop)1\nCUTLASS : template library\nThreads : parallel algorthims",
      "autoResize": true,
      "lineHeight": 1.25
    },
