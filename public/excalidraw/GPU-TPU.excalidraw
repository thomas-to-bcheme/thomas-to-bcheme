    {
      "id": "OlS0nh3ubYW9-W1HKiLYp",
      "type": "text",
      "x": 182.22466652208277,
      "y": -959.4911965325468,
      "width": 1365.759033203125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
