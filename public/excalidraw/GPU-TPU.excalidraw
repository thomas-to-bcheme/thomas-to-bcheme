    {
      "id": "OlS0nh3ubYW9-W1HKiLYp",
      "type": "text",
      "x": 180.67992922543363,
      "y": -1004.430622944245,
      "width": 1365.759033203125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
