    {
      "id": "RfTu5aW3yKJr2zZZRLkw2",
      "type": "text",
      "x": -11747.367186046391,
      "y": -2853.3370784534836,
      "width": 820.8193969726562,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "CS4m5clLlJch_PMWiidFi",
