      "width": 680,
      "height": 1933,
      "name": "ML Engineering — Senior-Level Best Practices",
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
