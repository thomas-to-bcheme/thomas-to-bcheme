      "seed": 496909798,
      "version": 549,
      "versionNonce": 331356538,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787191463249,
      "link": null,
      "locked": false,
      "text": "design of the job board\n~ heuristics we are designing for to implement\n1. apply directly on the job board, <24 hours of posting\n2. resume (agent) -> interviews!\n   2.1 1,2 to pages, ATS key words, summary? technologies?\n... 2.2 should be tailored specifically to the job\n3. Interview prep is out of scope of the job board\n-> actively outbound apply to jobs to get interviews!\n\n3. \"if you see a job that you think you're >50% qualified for, apply!\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "design of the job board\n~ heuristics we are designing for to implement\n1. apply directly on the job board, <24 hours of posting\n2. resume (agent) -> interviews!\n   2.1 1,2 to pages, ATS key words, summary? technologies?\n... 2.2 should be tailored specifically to the job\n3. Interview prep is out of scope of the job board\n-> actively outbound apply to jobs to get interviews!\n\n3. \"if you see a job that you think you're >50% qualified for, apply!\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
