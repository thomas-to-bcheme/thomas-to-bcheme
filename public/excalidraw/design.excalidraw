    {
      "id": "g3CommLftHead",
      "type": "text",
      "x": 1943.7887999739823,
      "y": 3284.351875355843,
      "width": 1650,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "HnMfl3zUaLJez2eI6LWk",
      "roundness": null,
