    {
      "id": "OHC1ThZebAP9Y5HTZ4mn7",
      "type": "text",
      "x": -2288.9858138456552,
      "y": 8341.355527100059,
      "width": 665.879638671875,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
