      "updated": 1787092948138,
      "link": null,
      "locked": false,
      "text": "Client→CDN (static)→LB (SSL+health)→WAF (OWASP)→API GW (auth, rate limit, route)→Services (stateless HPA)→{Redis (L2 cache), Kafka (async), PostgreSQL (ACID), S3 (blobs)}→{Read Replicas (80% reads), Workers (async consumers), Monitoring (RED+USE+traces)}",
      "originalText": "Client→CDN (static)→LB (SSL+health)→WAF (OWASP)→API GW (auth, rate limit, route)→Services (stateless HPA)→{Redis (L2 cache), Kafka (async), PostgreSQL (ACID), S3 (blobs)}→{Read Replicas (80% reads), Workers (async consumers), Monitoring (RED+USE+traces)}",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0Y"
    },
    {
      "id": "g3TitleSecB01",
      "type": "text",
      "x": 1943.7887999739823,
      "y": 1966.3518753558428,
      "width": 2400,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "HnMfl3zUaLJez2eI6LWk",
      "roundness": null,
