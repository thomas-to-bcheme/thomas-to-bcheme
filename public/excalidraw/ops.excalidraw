    {
      "id": "d75byDXF5qunwynXQcw-Y",
      "type": "text",
      "x": -10625.037222410805,
      "y": 10587.16989054764,
      "width": 2153.684210526316,
      "height": 538.421052631579,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
