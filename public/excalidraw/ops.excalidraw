    {
      "id": "lTkZ7cLrDfGbg0MGGgAIY",
      "type": "frame",
      "x": -13399.129806326331,
      "y": 12392.636962780041,
      "width": 680,
      "height": 1933,
      "name": "Cloud & DevOps — Senior-Level Best Practices",
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
