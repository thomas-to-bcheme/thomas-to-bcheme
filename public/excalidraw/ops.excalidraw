      "text": "Big Data Compute: Hardware & Engine Scaling",
      "fontSize": 49.46379310344828,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 22,
      "frameId": "Ns8tkcfQ1gouZGlgHC0ly",
      "roundness": null,
      "containerId": null,
      "originalText": "Big Data Compute: Hardware & Engine Scaling",
      "autoResize": true,
      "lineHeight": 1.1666666666666667
    },
    {
      "id": "I63V-y7_oO-xN0xjU0rca",
      "type": "text",
      "x": -8793.912869307946,
      "y": 9721.684603899454,
      "width": 1380.8642241379312,
      "height": 370.9784482758621,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "strokeSharpness": "sharp",
      "seed": 514615711,
      "version": 54,
      "versionNonce": 230523711,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783988529395,
      "link": null,
      "locked": false,
      "text": "Pandas (Single-Core, Single CPU):\nLoads entire dataset into RAM. Incredibly fast for small data,\nbut hits a hard bottleneck based on the instance's memory size.\n\nPolars / DuckDB (Multi-Core, Single CPU):\nVectorized execution utilizes all cores on a single machine. Maximize\nvertical scaling (e.g., massive EC2/GCE instances) to avoid network latency.\n\nSpark / Trino (Multi-Core, Distributed CPUs):\nScales horizontally across clusters. Incurs heavy network shuffling latency. \nUse ONLY when data size exceeds a single machine's RAM/Disk limits.",
      "fontSize": 32.97586206896552,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "frameId": "Ns8tkcfQ1gouZGlgHC0ly",
      "roundness": null,
      "containerId": null,
      "originalText": "Pandas (Single-Core, Single CPU):\nLoads entire dataset into RAM. Incredibly fast for small data,\nbut hits a hard bottleneck based on the instance's memory size.\n\nPolars / DuckDB (Multi-Core, Single CPU):\nVectorized execution utilizes all cores on a single machine. Maximize\nvertical scaling (e.g., massive EC2/GCE instances) to avoid network latency.\n\nSpark / Trino (Multi-Core, Distributed CPUs):\nScales horizontally across clusters. Incurs heavy network shuffling latency. \nUse ONLY when data size exceeds a single machine's RAM/Disk limits.",
      "autoResize": true,
      "lineHeight": 1.0227272727272727
    },
