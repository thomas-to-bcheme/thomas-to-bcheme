      "seed": 1642484369,
      "version": 186,
      "versionNonce": 924971935,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783988529395,
      "link": null,
      "locked": false,
      "text": "ARCHITECTURAL NEED       | OPEN SOURCE/AGNOSTIC | AWS                 | GCP                  | AZURE\n-------------------------------------------------------------------------------------------------------------------------\nServerless Containers    | Knative, OpenFaaS    | AWS Fargate         | Cloud Run            | Azure Container Apps\nDistributed/Wide-Column  | Apache Cassandra     | Amazon Keyspaces    | Cloud Bigtable       | Cosmos DB (Cassandra)\nData Warehouse/Lakehouse | Apache Iceberg+Trino | Amazon Redshift     | BigQuery             | Azure Synapse / Fabric\nGraph Database           | Neo4j, TinkerPop     | Neptune Serverless  | Spanner Graph        | Cosmos DB (Gremlin)\nHigh-Throughput Stream   | Apache Kafka         | Amazon MSK/Kinesis  | Pub/Sub              | Event Hubs\nService Mesh             | Istio, Linkerd       | AWS App Mesh        | Anthos Service Mesh  | Azure Service Mesh\nGenerative AI / LLMs     | vLLM + HuggingFace   | Amazon Bedrock      | Vertex AI            | Azure OpenAI Service",
      "fontSize": 32.305263157894736,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "frameId": "Ns8tkcfQ1gouZGlgHC0ly",
      "roundness": null,
      "containerId": null,
      "originalText": "ARCHITECTURAL NEED       | OPEN SOURCE/AGNOSTIC | AWS                 | GCP                  | AZURE\n-------------------------------------------------------------------------------------------------------------------------\nServerless Containers    | Knative, OpenFaaS    | AWS Fargate         | Cloud Run            | Azure Container Apps\nDistributed/Wide-Column  | Apache Cassandra     | Amazon Keyspaces    | Cloud Bigtable       | Cosmos DB (Cassandra)\nData Warehouse/Lakehouse | Apache Iceberg+Trino | Amazon Redshift     | BigQuery             | Azure Synapse / Fabric\nGraph Database           | Neo4j, TinkerPop     | Neptune Serverless  | Spanner Graph        | Cosmos DB (Gremlin)\nHigh-Throughput Stream   | Apache Kafka         | Amazon MSK/Kinesis  | Pub/Sub              | Event Hubs\nService Mesh             | Istio, Linkerd       | AWS App Mesh        | Anthos Service Mesh  | Azure Service Mesh\nGenerative AI / LLMs     | vLLM + HuggingFace   | Amazon Bedrock      | Vertex AI            | Azure OpenAI Service",
      "autoResize": true,
      "lineHeight": 1.851851851851852
    },
