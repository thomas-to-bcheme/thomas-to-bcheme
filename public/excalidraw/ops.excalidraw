      "link": null,
      "locked": false,
      "text": "Storage Mechanics: B-Tree vs. LSM-Tree",
      "fontSize": 49.46379310344828,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 22,
      "frameId": "Ns8tkcfQ1gouZGlgHC0ly",
      "roundness": null,
      "containerId": null,
      "originalText": "Storage Mechanics: B-Tree vs. LSM-Tree",
      "autoResize": true,
      "lineHeight": 1.1666666666666667
    },
    {
      "id": "4DIT7ybzd2SePkNRIhixO",
      "type": "text",
      "x": -10319.046489997601,
      "y": 9721.684603899454,
      "width": 1380.8642241379312,
      "height": 370.9784482758621,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "strokeSharpness": "sharp",
      "seed": 857994559,
      "version": 75,
      "versionNonce": 980986591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783988529395,
      "link": null,
      "locked": false,
      "text": "B-Tree (PostgreSQL, Cloud SQL, Aurora):\nOptimized for Read-Heavy workloads, point lookups, and \ncomplex joins. Updates data in place (random I/O). \nSuffers from fragmentation under extreme write loads.\n\nLSM-Tree (Cassandra, Bigtable, DynamoDB):\nOptimized for extreme Write-Heavy workloads (Time-series, IoT).\nAppends data sequentially (fastest possible I/O). Reads can be \nslower as the engine must check multiple SSTable levels/memtables.",
      "fontSize": 32.97586206896552,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "frameId": "Ns8tkcfQ1gouZGlgHC0ly",
      "roundness": null,
      "containerId": null,
      "originalText": "B-Tree (PostgreSQL, Cloud SQL, Aurora):\nOptimized for Read-Heavy workloads, point lookups, and \ncomplex joins. Updates data in place (random I/O). \nSuffers from fragmentation under extreme write loads.\n\nLSM-Tree (Cassandra, Bigtable, DynamoDB):\nOptimized for extreme Write-Heavy workloads (Time-series, IoT).\nAppends data sequentially (fastest possible I/O). Reads can be \nslower as the engine must check multiple SSTable levels/memtables.",
      "autoResize": true,
      "lineHeight": 1.25
    },
