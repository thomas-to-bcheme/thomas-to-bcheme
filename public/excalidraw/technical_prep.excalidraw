      "locked": false,
      "text": "HLD COMPONENT BEST PRACTICES",
      "originalText": "HLD COMPONENT BEST PRACTICES",
      "fontSize": 34.06,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
