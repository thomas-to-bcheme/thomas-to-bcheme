      "text": "STAFF-LEVEL APTITUDE SIGNALS",
      "originalText": "STAFF-LEVEL APTITUDE SIGNALS",
      "fontSize": 24,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
