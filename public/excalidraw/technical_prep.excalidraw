    {
      "id": "g1B1780Bdy",
      "type": "text",
      "x": 1780,
      "y": 2460,
      "width": 1760,
      "height": 1150,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "rEX9ZkQmLMonBL9XY3xl",
      "roundness": null,
      "seed": 1017,
      "version": 2,
      "versionNonce": 17039701,
