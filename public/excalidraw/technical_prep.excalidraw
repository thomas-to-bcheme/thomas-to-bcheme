      "text": "STEP 2 — High-Level Design (~20 min)",
      "originalText": "STEP 2 — High-Level Design (~20 min)",
      "fontSize": 34.06,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
