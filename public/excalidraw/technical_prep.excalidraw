      "index": "b7A"
    },
    {
      "id": "g3BPLeftBody1",
      "type": "text",
      "x": 594.2247549578747,
      "y": 6608.717408772298,
      "width": 1650,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "HnMfl3zUaLJez2eI6LWk",
      "roundness": null,
