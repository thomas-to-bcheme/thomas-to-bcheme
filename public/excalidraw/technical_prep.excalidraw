    {
      "id": "Aw2nmilN8y250MDJEICwD",
      "type": "text",
      "x": 1641.0994894990672,
      "y": 2552.7550673387836,
      "width": 213.61981201171875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1971c2",
