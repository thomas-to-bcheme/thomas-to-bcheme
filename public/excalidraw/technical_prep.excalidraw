      "boundElements": [],
      "updated": 1782285580681,
      "link": null,
      "locked": false,
      "text": "Compute\n- (Persistent) Server?\n- Serverless?\n- pricing model?\n- scaling?\n- containerization?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
