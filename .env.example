# Hugging Face — ZeroGPU Space (backend/)
# Write-scoped token; used only by .github/workflows/deploy-backend.yml
# to create/update the thomas-to-bcheme/portfolio-zerogpu Space via HfApi().
# Never read by backend/app.py. Never exposed to the browser.
HF_TOKEN_WRITE=

# Read-scoped token; used server-side by the Next.js frontend to call the
# deployed Space's /infer endpoint via gradio_client, attributing usage to
# your own HF account/quota. Must NOT be prefixed NEXT_PUBLIC_ (would leak
# to the client bundle).
HF_TOKEN_READ=
